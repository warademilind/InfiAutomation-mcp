{
  "name": "@infiautomation/mcp",
  "version": "0.5.0",
  "description": "Unified MCP for web, Electron, Windows desktop, REST/SOAP, database and UX testing with policy, traceability and offline timing reports.",
  "type": "module",
  "license": "MIT",
  "author": "Milind Warade",
  "repository": {
    "type": "git",
    "url": "https://github.com/warademilind/InfiAutomation-mcp.git"
  },
  "homepage": "https://github.com/warademilind/InfiAutomation-mcp#readme",
  "bugs": {
    "url": "https://github.com/warademilind/InfiAutomation-mcp/issues"
  },
  "keywords": [
    "mcp",
    "playwright",
    "flaui",
    "electron",
    "testing",
    "desktop",
    "self-healing",
    "api-testing",
    "soap",
    "database",
    "accessibility",
    "visual-regression"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "infiautomation-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "native/InfiAutomation.Native/Program.cs",
    "native/InfiAutomation.Native/InfiAutomation.Native.csproj",
    "native/InfiAutomation.Native/packages.lock.json",
    "native/licenses",
    "scripts/build-native.mjs",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 integration/*.test.ts",
    "build:native": "node scripts/build-native.mjs",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test:integration:web": "node --import tsx --test --test-name-pattern=\"real Chromium\" integration/adapters.test.ts",
    "test:integration:electron": "node --import tsx --test --test-concurrency=1 --test-name-pattern=\"real Electron\" integration/adapters.test.ts integration/electron.test.ts",
    "test:integration:electron:native": "node --import tsx --test --test-name-pattern=\"real Electron Windows UIA\" integration/electron.test.ts",
    "test:integration:native": "node --import tsx --test --test-name-pattern=\"real Windows\" integration/adapters.test.ts",
    "test:unified": "node scripts/verify-unified-demo.mjs",
    "test:databases": "node scripts/verify-database-services.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-xml-parser": "5.11.2",
    "mammoth": "1.13.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "unpdf": "2.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "tsx": "^4.0.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
