{
  "claudeDesktopOrCursor": {
    "mcpServers": {
      "infiautomation": {
        "command": "node",
        "args": [
          "/absolute/path/infiautomation-mcp/dist/cli.js"
        ],
        "env": {
          "INFIAUTOMATION_WORKSPACE": "/absolute/path/your-test-project"
        }
      }
    }
  },
  "vscode": {
    "servers": {
      "infiautomation": {
        "type": "stdio",
        "command": "node",
        "args": [
          "/absolute/path/infiautomation-mcp/dist/cli.js"
        ],
        "env": {
          "INFIAUTOMATION_WORKSPACE": "/absolute/path/your-test-project"
        }
      }
    }
  },
  "windows": {
    "mcpServers": {
      "infiautomation": {
        "command": "node",
        "args": [
          "D:\\infiautomation-mcp\\dist\\cli.js"
        ],
        "env": {
          "INFIAUTOMATION_WORKSPACE": "D:\\tests",
          "INFIAUTOMATION_NATIVE_WORKER": "D:\\infiautomation-worker\\InfiAutomation.Native.dll"
        }
      }
    }
  }
}