    {"kind": "ui", "target": "calculator", "name": "Equals", "step": {"name": "Equals", "action": "click", "locator": {"automationId": "equalButton"}}},
    {"kind": "ui", "target": "calculator", "name": "Verify native result", "step": {"name": "Result", "action": "assertText", "locator": {"automationId": "CalculatorResults"}, "value": "Display is 5"}}
